{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "github-claude-webhook-bridge",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "vars": {
    // Only deliveries from repositories owned by these users or orgs are considered.
    "ALLOWED_OWNERS": ["dvcrn", "digitalvibeshq", "microfnhq"],
    // Logins allowed to trigger the routine with a comment, label or assignment. A leading "@" is optional.
    "ALLOWED_ACTORS": ["dvcrn"],
    // Per route (/webhook/<name>), what fires its routine:
    //   COMMENT_KEYWORDS: a new comment (or an edit) adds one of these keywords
    //   LABELS: an issue or PR gets one of these labels
    //   ASSIGNEES: an issue or PR is assigned to one of these logins
    "ROUTE_FILTERS": {
      "boticorn": { "COMMENT_KEYWORDS": ["@boticorn"], "ASSIGNEES": ["boticorn"] },
      "reviewicorn": { "COMMENT_KEYWORDS": ["@reviewicorn"], "LABELS": ["reviewicorn"] }
    },
    // Events sent by these logins are dropped so the bot can't trigger itself.
    "IGNORED_SENDERS": ["boticorn", "boticorn[bot]"]
  },
  // pull_request "opened" is forwarded for any non-bot author, forks included.
  // Secrets (set with `wrangler secret put`):
  //   GITHUB_WEBHOOK_SECRET, ROUTINES (JSON route name -> {url, token}, see README)
  "observability": {
    "logs": {
      "enabled": true,
      "destinations": ["new-relic-logs", "axiom-logs"],
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    }
  }
}
